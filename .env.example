# Copy to .env and adjust before first deployment.

COMPOSE_PROJECT_NAME=opensabre

# Public access settings.
PUBLIC_HOST=localhost
AUTH_ISSUER_URI=http://localhost:8000
GATEWAY_REDIRECT_URI=http://localhost:8443/login/oauth2/code/base-gateway-client
GATEWAY_OAUTH_CLIENT_ID=test_client1
GATEWAY_OAUTH_CLIENT_SECRET=test_client1

# Nacos 公共配置定位信息。配置内容在 config/nacos/ 中版本管理并发布到 Nacos。
OPENSABRE_COMMON_CONFIG_DATA_ID=opensabre-common.yml
OPENSABRE_COMMON_CONFIG_GROUP=DEFAULT_GROUP

# Optional RNacos advertised IP. Leave empty for Docker-network-only access.
# Set to the application host IP when local/remote clients must call instances directly.
NACOS_DISCOVERY_IP=

# Infrastructure connection settings used by application containers.
# For split-server deployment, set these hosts to the middleware server private IP or DNS name
# in the .env file used by docker-compose-apps.yml.
REGISTER_HOST=rnacos
REGISTER_PORT=8848
REDIS_HOST=redis
REDIS_PORT=6379
DATASOURCE_DBTYPE=mysql
DATASOURCE_HOST=mysql
DATASOURCE_PORT=3306
DATASOURCE_USERNAME=opensabre
DATASOURCE_PASSWORD=opensabre_change_me
RABBIT_MQ_HOST=rabbitmq
RABBIT_MQ_PORT=5672
RABBIT_MQ_USERNAME=opensabre
RABBIT_MQ_PASSWORD=opensabre_change_me
SENTINEL_DASHBOARD_HOST=sentinel-dashboard
SENTINEL_DASHBOARD_PORT=8858
CONTAINER_HOME=/app

# Shared credential for framework governance registrations (error catalog, dictionaries, etc.).
GOVERNANCE_REGISTRATION_TOKEN=replace_with_a_long_random_value

# Infrastructure credentials.
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=opensabre
RABBITMQ_DEFAULT_USER=opensabre
RABBITMQ_DEFAULT_PASS=opensabre_change_me

# Image tags. Pin these for repeatable production deployments.
BASE_GATEWAY_IMAGE=ccr.ccs.tencentyun.com/opensabre/base-gateway:latest
BASE_AUTHORIZATION_IMAGE=ccr.ccs.tencentyun.com/opensabre/base-authorization:latest
BASE_ORGANIZATION_IMAGE=ccr.ccs.tencentyun.com/opensabre/base-organization:latest
BASE_SYSADMIN_IMAGE=ccr.ccs.tencentyun.com/opensabre/base-sysadmin:latest
OPENSABRE_ADMIN_IMAGE=ccr.ccs.tencentyun.com/opensabre/opensabre-admin:master

MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
RNACOS_IMAGE=qingpan/rnacos:stable
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
SENTINEL_DASHBOARD_IMAGE=bladex/sentinel-dashboard:1.8.8
